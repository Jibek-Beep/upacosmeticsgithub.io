<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Beauty Secrets — Korean Skincare</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,900&family=Work+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <style>
    :root {
      --ink: #171313;
      --paper: #fffafc;
      --pink: #f51d70;
      --soft-pink: #ffd7e6;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      width: 100%;
      min-height: 100vh;
      color: var(--ink);
      background: var(--paper);
      font-family: "Work Sans", sans-serif;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    img {
      display: block;
      max-width: 100%;
    }

    .display-font {
      font-family: "Fraunces", serif;
    }

    /* NAVIGATION */

    .site-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255, 250, 252, 0.94);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--ink);
    }

    .nav-container {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .nav-inner {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .logo {
      font-family: "Fraunces", serif;
      font-size: 26px;
      font-weight: 900;
      letter-spacing: -0.06em;
      white-space: nowrap;
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      gap: 30px;
      margin-left: auto;
    }

    .nav-link {
      position: relative;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .nav-link::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 100%;
      height: 2px;
      background: var(--pink);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.2s ease;
    }

    .nav-link:hover::after,
    .nav-link:focus-visible::after {
      transform: scaleX(1);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cart-button {
      border: 0;
      background: transparent;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      color: var(--ink);
    }

    .cart-icon {
      font-size: 22px;
    }

    .cart-count {
      min-width: 21px;
      height: 21px;
      padding: 0 5px;
      display: inline-grid;
      place-items: center;
      background: var(--ink);
      color: white;
      font-size: 10px;
      font-weight: 800;
    }

    .mobile-toggle {
      display: none;
      width: 42px;
      height: 42px;
      border: 1px solid var(--ink);
      background: transparent;
      cursor: pointer;
      font-size: 20px;
    }

    .mobile-menu {
      display: none;
      padding-bottom: 20px;
    }

    .mobile-menu.open {
      display: block;
    }

    .mobile-menu-inner {
      border: 1px solid var(--ink);
      background: white;
    }

    .mobile-menu a {
      display: block;
      padding: 16px;
      border-bottom: 1px solid var(--ink);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .mobile-menu a:last-child {
      border-bottom: 0;
    }

    /* HERO */

    .hero {
      display: grid;
      grid-template-columns: 1.04fr 0.96fr;
      min-height: 76vh;
      border-bottom: 1px solid var(--ink);
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 64px;
    }

    .hero-content {
      max-width: 700px;
    }

    .eyebrow,
    .section-kicker {
      margin: 0 0 26px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .hero-title {
      margin: 0;
      font-family: "Fraunces", serif;
      font-size: clamp(4rem, 8vw, 9rem);
      line-height: 0.84;
      letter-spacing: -0.065em;
      font-weight: 900;
    }

    .hero-description {
      max-width: 570px;
      margin: 32px 0 0;
      font-size: 18px;
      line-height: 1.65;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 48px;
    }

    .hard-button {
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 20px;
      border: 1px solid var(--ink);
      background: white;
      color: var(--ink);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease,
        background 0.18s ease;
    }

    .hard-button:hover {
      transform: translate(-4px, -4px);
      box-shadow: 5px 5px 0 var(--ink);
    }

    .pink-button {
      background: var(--pink);
      color: white;
    }

    .hero-note {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .hero-photo {
      position: relative;
      min-height: 480px;
      overflow: hidden;
      border-left: 1px solid var(--ink);
      background: #f4dce6;
    }

    .hero-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(0.88) contrast(1.06);
    }

    .hero-photo::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          135deg,
          rgba(245, 29, 112, 0.2),
          transparent 55%
        );
      pointer-events: none;
    }

    .hero-label {
      position: absolute;
      right: 28px;
      bottom: 24px;
      z-index: 2;
      color: white;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      writing-mode: vertical-rl;
    }

    /* TICKER */

    .ticker {
      overflow: hidden;
      white-space: nowrap;
      background: var(--pink);
      color: white;
      border-bottom: 1px solid var(--ink);
    }

    .ticker-inner {
      display: inline-block;
      min-width: 100%;
      padding: 12px 0;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      animation: tickerMove 22s linear infinite;
    }

    @keyframes tickerMove {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(-35%);
      }
    }

    /* GENERAL SECTIONS */

    .section {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 96px 24px;
    }

    .catalog-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 40px;
      margin-bottom: 56px;
    }

    .catalog-title,
    .about-title {
      margin: 0;
      font-family: "Fraunces", serif;
      font-weight: 900;
      line-height: 0.92;
      letter-spacing: -0.055em;
    }

    .catalog-title {
      font-size: clamp(3rem, 6vw, 6rem);
    }

    .catalog-note {
      max-width: 400px;
      margin: 0;
      font-size: 14px;
      line-height: 1.7;
      text-align: right;
    }

    /* PRODUCTS */

    .products {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .product-card {
      position: relative;
      overflow: hidden;
      background: white;
      border: 1px solid var(--ink);
      transition:
        transform 0.22s ease,
        box-shadow 0.22s ease;
    }

    .product-card:hover {
      transform: translateY(-7px);
      box-shadow: 8px 8px 0 var(--pink);
    }

    .product-image {
      width: 100%;
      aspect-ratio: 1 / 1.08;
      object-fit: cover;
      border-bottom: 1px solid var(--ink);
      background: #f9e6ed;
      transition: transform 0.5s ease;
    }

    .product-card:hover .product-image {
      transform: scale(1.06);
    }

    .product-content {
      padding: 20px;
    }

    .product-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
    }

    .product-category {
      margin: 0;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .number-tag {
      width: 38px;
      height: 38px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      border: 1px solid var(--ink);
      background: white;
      font-size: 11px;
      font-weight: 800;
    }

    .product-title {
      margin: 0;
      font-family: "Fraunces", serif;
      font-size: 23px;
      line-height: 1.1;
      font-weight: 700;
    }

    .product-description {
      min-height: 70px;
      margin: 12px 0 0;
      font-size: 14px;
      line-height: 1.6;
    }

    .product-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid var(--ink);
    }

    .price {
      font-size: 14px;
      font-weight: 800;
      white-space: nowrap;
    }

    .add-button {
      min-height: auto;
      padding: 9px 12px;
      font-size: 10px;
    }

    /* PHILOSOPHY */

    .philosophy {
      border-top: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
    }

    .philosophy-inner {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .about-copy {
      padding: 70px 64px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .about-title {
      max-width: 650px;
      font-size: clamp(3rem, 5vw, 5.8rem);
    }

    .about-description {
      max-width: 600px;
      margin: 30px 0 0;
      font-size: 18px;
      line-height: 1.7;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin-top: 55px;
      border-top: 1px solid var(--ink);
    }

    .stat {
      padding: 18px 12px 0;
    }

    .stat + .stat {
      border-left: 1px solid var(--ink);
    }

    .stat-number {
      display: block;
      font-family: "Fraunces", serif;
      font-size: 34px;
      font-weight: 900;
    }

    .stat-label {
      display: block;
      margin-top: 7px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .about-photo {
      min-height: 500px;
      overflow: hidden;
    }

    .about-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: contrast(1.1) saturate(0.82);
    }

    /* FOOTER */

    footer {
      border-top: 0;
    }

    .footer-inner {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 64px 24px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 0.6fr 0.8fr;
      gap: 40px;
    }

    .footer-logo {
      margin: 0;
      font-family: "Fraunces", serif;
      font-size: 50px;
      font-weight: 900;
      letter-spacing: -0.06em;
      line-height: 1;
    }

    .footer-description {
      max-width: 400px;
      margin: 20px 0 0;
      font-size: 14px;
      line-height: 1.7;
    }

    .footer-heading {
      margin: 0;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      margin-top: 20px;
    }

    .footer-links a {
      font-size: 14px;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: var(--pink);
    }

    .socials {
      display: flex;
      gap: 8px;
      margin-top: 20px;
    }

    .social {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border: 1px solid var(--ink);
      font-size: 12px;
      font-weight: 800;
      transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
    }

    .social:hover {
      color: white;
      background: var(--pink);
      transform: translateY(-3px);
    }

    .footer-bottom {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      margin-top: 48px;
      padding-top: 20px;
      border-top: 1px solid var(--ink);
    }

    .footer-bottom span {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* TOAST */

    .toast {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 200;
      max-width: 320px;
      padding: 16px;
      color: white;
      background: var(--ink);
      border: 1px solid var(--ink);
      box-shadow: 6px 6px 0 var(--pink);
      transform: translateY(140%);
      opacity: 0;
      pointer-events: none;
      transition:
        transform 0.3s ease,
        opacity 0.3s ease;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    .toast p {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
    }

    /* ANIMATION */

    .reveal {
      animation: rise 0.75s both;
    }

    .delay-1 {
      animation-delay: 0.1s;
    }

    .delay-2 {
      animation-delay: 0.2s;
    }

    .delay-3 {
      animation-delay: 0.3s;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* TABLET */

    @media (max-width: 1000px) {
      .hero-copy {
        padding: 50px 40px;
      }

      .products {
        grid-template-columns: repeat(2, 1fr);
      }

      .philosophy-inner {
        grid-template-columns: 1fr;
      }

      .about-copy {
        padding: 60px 40px;
      }

      .about-photo {
        min-height: 450px;
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }

      .footer-grid > :first-child {
        grid-column: 1 / -1;
      }
    }

    /* MOBILE */

    @media (max-width: 850px) {
      .nav-container {
        padding: 0 18px;
      }

      .desktop-nav {
        display: none;
      }

      .mobile-toggle {
        display: grid;
        place-items: center;
      }

      .hero {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .hero-copy {
        padding: 60px 24px;
      }

      .hero-photo {
        min-height: 420px;
        border-left: 0;
        border-top: 1px solid var(--ink);
      }

      .section {
        padding: 70px 18px;
      }

      .catalog-heading {
        flex-direction: column;
        align-items: flex-start;
        margin-bottom: 40px;
      }

      .catalog-note {
        text-align: left;
      }

      .about-copy {
        padding: 60px 24px;
      }

      .about-photo {
        min-height: 400px;
      }

      .footer-inner {
        padding: 55px 18px;
      }
    }

    @media (max-width: 560px) {
      .logo {
        font-size: 22px;
      }

      .hero-copy {
        padding: 55px 20px;
      }

      .hero-title {
        font-size: clamp(3.6rem, 17vw, 5.5rem);
      }

      .hero-description {
        font-size: 16px;
      }

      .hero-photo {
        min-height: 360px;
      }

      .products {
        grid-template-columns: 1fr;
      }

      .product-description {
        min-height: auto;
      }

      .about-copy {
        padding: 50px 20px;
      }

      .stats {
        margin-top: 40px;
      }

      .stat-number {
        font-size: 27px;
      }

      .stat-label {
        font-size: 8px;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .footer-grid > :first-child {
        grid-column: auto;
      }

      .footer-logo {
        font-size: 42px;
      }

      .footer-bottom {
        flex-direction: column;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>

  <!-- NAVIGATION -->
  <header class="site-nav">
    <div class="nav-container">
      <div class="nav-inner">

        <a href="#top" class="logo" aria-label="Beauty Secrets — на главную">
          Beauty Secrets
        </a>

        <nav class="desktop-nav" aria-label="Основная навигация">
          <a class="nav-link" href="#catalog">Каталог</a>
          <a class="nav-link" href="#philosophy">Философия</a>
          <a class="nav-link" href="#contacts">Контакты</a>
        </nav>

        <div class="nav-actions">

          <button
            class="cart-button"
            type="button"
            aria-label="Корзина"
            id="cartButton"
          >
            <span class="cart-icon">🛍</span>
            <span class="cart-count" id="cartCount">0</span>
          </button>

          <button
            class="mobile-toggle"
            id="mobileToggle"
            type="button"
            aria-label="Открыть меню"
            aria-expanded="false"
          >
            ☰
          </button>

        </div>
      </div>

      <nav class="mobile-menu" id="mobileMenu" aria-label="Мобильная навигация">
        <div class="mobile-menu-inner">
          <a href="#catalog">Каталог</a>
          <a href="#philosophy">Философия</a>
          <a href="#contacts">Контакты</a>
        </div>
      </nav>

    </div>
  </header>


  <main id="top">

    <!-- HERO -->
    <section class="hero">

      <div class="hero-copy">

        <div class="hero-content">

          <p class="eyebrow reveal">
            Korean skincare / 2026
          </p>

          <h1 class="hero-title reveal delay-1">
            Beauty<br>
            Secrets
          </h1>

          <p class="hero-description reveal delay-2">
            Корейский уход без лишнего шума.
            Формулы, которые работают с кожей каждый день —
            мягко, красиво и осознанно.
          </p>

        </div>

        <div class="hero-actions reveal delay-3">

          <a href="#catalog" class="hard-button pink-button">
            Смотреть каталог →
          </a>

          <span class="hero-note">
            Seoul · Bishkek · Online
          </span>

        </div>

      </div>


      <div class="hero-photo">

        <img
          src="pol.jpeg?auto=format&fit=crop&w=1000&q=85"
          alt="Корейская косметика и уход за кожей"
        >

        <span class="hero-label">
          Beauty Secrets/ Korean Beauty
        </span>

      </div>

    </section>


    <!-- TICKER -->
    <section class="ticker" aria-label="Преимущества">

      <div class="ticker-inner">
        CLEAN FORMULAS ✦ GLOWING SKIN ✦ KOREAN BEAUTY ✦ DAILY RITUAL ✦ CLEAN FORMULAS ✦ GLOWING SKIN ✦ KOREAN BEAUTY ✦ DAILY RITUAL ✦
      </div>

    </section>


    <!-- CATALOG -->
    <section id="catalog" class="section">

      <div class="catalog-heading">

        <div>
          <p class="section-kicker">
            Our edit / 01
          </p>

          <h2 class="catalog-title">
            Избранный<br>
            уход.
          </h2>
        </div>

        <p class="catalog-note">
          Одинадцать средств для простой и эффективной
          ежедневной рутины. Начните с базового ухода
          и постепенно создавайте свой skin ritual.
        </p>

      </div>


      <div class="products">

        <!-- PRODUCT 1 -->
        <article class="product-card">

          <img
            class="product-image"
            src="althea.webp"
            alt="Glass Skin Крем"
            loading="lazy"
          >

          <div class="product-content">

            <div class="product-top">
              <p class="product-category">Крем</p>
              <span class="number-tag">01</span>
            </div>

            <h3 class="product-title">
              крем от бренда DR/Althea
            </h3>

            <p class="product-description">
              Увлажняющий и восстанавливающий крем для сухой и чувствительной кожи. Укрепляет защитный барьер, устраняет сухость и стянутость, оставляя кожу мягкой и гладкой.
            </p>

            <div class="product-bottom">

              <span class="price">
                1499 сом
              </span>

              <button
                class="hard-button add-button add-to-cart"
                data-product="Glass Skin Serum"
                type="button"
              >
                В корзину
              </button>

            </div>

          </div>

        </article>


        <!-- PRODUCT 2 -->
